{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crazycraft://remote-job-request.schema.json",
  "title": "Crazy Craft bounded remote job request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "job_type",
    "requesting_authority",
    "assignment_id",
    "campaign_id",
    "exact_input_authorities",
    "permitted_evidence_roots",
    "permitted_candidate_paths",
    "permitted_output_directory",
    "prohibited_disclosure_classes",
    "timeout_seconds",
    "termination_policy",
    "requested_result_schema",
    "request_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "crazycraft-remote-v1"},
    "job_id": {"type": "string", "pattern": "^JOB-[0-9]{12}$"},
    "job_type": {
      "enum": [
        "EVIDENCE_RECOVERY",
        "PRIVATE_CANDIDATE_AUDIT",
        "BDS_QUALIFICATION",
        "COMBINED_PRIVATE_AUDIT_AND_QUALIFICATION"
      ]
    },
    "requesting_authority": {"enum": ["T1", "T10"]},
    "assignment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "exact_input_authorities": {
      "type": "array",
      "items": {"type": "object"},
      "minItems": 1
    },
    "permitted_evidence_roots": {
      "type": "array",
      "items": {"type": "string", "pattern": "^/"}
    },
    "permitted_candidate_paths": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[^.\\\\/][^\\\\]*$"}
    },
    "permitted_output_directory": {"const": "artifacts"},
    "prohibited_disclosure_classes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 9,
      "items": {
        "enum": [
          "RAW_JAVA",
          "DECOMPILED_TEXT",
          "SOURCE_IDENTIFIERS",
          "SOURCE_PATHS",
          "SOURCE_ASSETS",
          "HIDDEN_CASES",
          "PRIVATE_ORACLE_VALUES",
          "CREDENTIALS",
          "SOURCE_EXPRESSION"
        ]
      }
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 21600},
    "termination_policy": {"const": "TERMINATE_AND_RECEIPT"},
    "requested_result_schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "request_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_repository",
        "candidate_ref",
        "content_commit",
        "content_tree",
        "metadata_commit",
        "metadata_tree",
        "behavior_pack_path",
        "behavior_pack_size",
        "behavior_pack_sha256",
        "resource_pack_path",
        "resource_pack_size",
        "resource_pack_sha256",
        "mcaddon_path",
        "mcaddon_size",
        "mcaddon_sha256",
        "image_digest",
        "image_platform",
        "qualifier_sha256",
        "bds_channel",
        "bds_version",
        "bds_binary_sha256",
        "base_world_sha256",
        "fixture_set",
        "expected_gates",
        "port",
        "container_name",
        "cpus",
        "memory_mb"
      ],
      "properties": {
        "candidate_repository": {"type": "string"},
        "candidate_ref": {"type": "string", "pattern": "^refs/"},
        "content_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "content_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "metadata_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "metadata_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "behavior_pack_path": {"type": "string", "pattern": "^[^.\\\\/][^\\\\]*$"},
        "behavior_pack_size": {"type": "integer", "minimum": 1},
        "behavior_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resource_pack_path": {"type": "string", "pattern": "^[^.\\\\/][^\\\\]*$"},
        "resource_pack_size": {"type": "integer", "minimum": 1},
        "resource_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mcaddon_path": {"type": "string", "pattern": "^[^.\\\\/][^\\\\]*$"},
        "mcaddon_size": {"type": "integer", "minimum": 1},
        "mcaddon_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_digest": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"},
        "image_platform": {"const": "linux/amd64"},
        "qualifier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bds_channel": {"enum": ["STABLE", "PREVIEW"]},
        "bds_version": {"type": "string"},
        "bds_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_world_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_set": {"type": "string"},
        "expected_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "port": {"type": "integer", "minimum": 19132, "maximum": 29999},
        "container_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "cpus": {"type": "integer", "minimum": 1, "maximum": 8},
        "memory_mb": {"type": "integer", "minimum": 512, "maximum": 16384},
        "candidate_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "behavior_pack",
            "resource_pack",
            "addon",
            "script",
            "expected_pack_marker",
            "world_name",
            "fixture_id"
          ],
          "properties": {
            "schema_version": {"const": "crazycraft-bds-candidate-profile-v1"},
            "behavior_pack": {"$ref": "#/$defs/packProfile"},
            "resource_pack": {"$ref": "#/$defs/packProfile"},
            "addon": {
              "type": "object",
              "additionalProperties": false,
              "required": ["behavior_member", "resource_member"],
              "properties": {
                "behavior_member": {"type": "string", "pattern": "^[^.\\\\/][^\\\\/]*\\.mcpack$"},
                "resource_member": {"type": "string", "pattern": "^[^.\\\\/][^\\\\/]*\\.mcpack$"}
              }
            },
            "script": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["entry_path", "expected_marker"],
                  "properties": {
                    "entry_path": {"type": "string", "pattern": "^[^.\\\\/][^\\\\]*$"},
                    "expected_marker": {"type": ["string", "null"], "maxLength": 200}
                  }
                }
              ]
            },
            "expected_pack_marker": {"type": "string", "minLength": 1, "maxLength": 160},
            "world_name": {"type": "string", "minLength": 1, "maxLength": 96},
            "fixture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
          }
        }
      }
    }
  },
  "$defs": {
    "packProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_uuid", "version", "install_directory"],
      "properties": {
        "manifest_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 0, "maximum": 65535},
            {"type": "integer", "minimum": 0, "maximum": 65535},
            {"type": "integer", "minimum": 0, "maximum": 65535}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "install_directory": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        }
      }
    }
  }
}
