{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crazycraft://remote-job-receipt.schema.json",
  "title": "Crazy Craft bounded remote job receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "request_sha256",
    "input_manifest_sha256",
    "requesting_authority",
    "studio_host_identity",
    "studio_executor_identity",
    "job_type",
    "started_at",
    "ended_at",
    "entrypoint",
    "evidence_roots_accessed",
    "candidate_inputs_accessed",
    "outputs",
    "disclosure_policy_scan",
    "exit_status",
    "cleanup_status",
    "docker_container_ids",
    "codex_session_identifier",
    "authority_envelope",
    "proof_boundary",
    "receipt_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "crazycraft-remote-v1"},
    "job_id": {"type": "string", "pattern": "^JOB-[0-9]{12}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requesting_authority": {"enum": ["T1", "T10"]},
    "studio_host_identity": {"type": "string"},
    "studio_executor_identity": {"type": "string"},
    "job_type": {"type": "string"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "entrypoint": {"type": "array", "items": {"type": "string"}},
    "evidence_roots_accessed": {"type": "array", "items": {"type": "string"}},
    "candidate_inputs_accessed": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "object"}},
    "disclosure_policy_scan": {"type": "object"},
    "exit_status": {"type": "integer"},
    "cleanup_status": {"type": "string"},
    "docker_container_ids": {"type": "array", "items": {"type": "string"}},
    "codex_session_identifier": {"type": ["string", "null"]},
    "authority_envelope": {
      "type": "object",
      "required": ["scheme", "identity", "payload_sha256", "verification"],
      "additionalProperties": false,
      "properties": {
        "scheme": {"type": "string"},
        "identity": {"type": "string"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification": {"type": "string"}
      }
    },
    "proof_boundary": {"type": "string", "minLength": 1},
    "receipt_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
