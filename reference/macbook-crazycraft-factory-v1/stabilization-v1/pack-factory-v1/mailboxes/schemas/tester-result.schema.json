{
  "$id": "https://crazycraft.local/factory/tester-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "candidate_generation": {
      "minimum": 0,
      "type": "integer"
    },
    "candidate_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "exact_artifact_hashes": {
      "type": "object"
    },
    "findings": {
      "type": "array"
    },
    "idempotency_key": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "message_id": {
      "pattern": "^[A-Z0-9][A-Z0-9._-]{7,127}$",
      "type": "string"
    },
    "message_type": {
      "enum": [
        "TEST_PASS",
        "TEST_FAIL_PRODUCT",
        "TEST_FAIL_INFRASTRUCTURE",
        "TEST_BLOCKED_CLIENT",
        "TEST_BLOCKED_PHYSICAL"
      ]
    },
    "pack_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "parent_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_boundary": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "qualification_receipts": {
      "type": "array"
    },
    "recipient_role": {
      "type": "string"
    },
    "required_action": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sender_role": {
      "type": "string"
    },
    "source_authority_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_authority_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "message_type",
    "pack_id",
    "sender_role",
    "recipient_role",
    "created_at",
    "source_authority_commit",
    "source_authority_tree",
    "candidate_generation",
    "exact_artifact_hashes",
    "parent_message_id",
    "required_action",
    "idempotency_key",
    "proof_boundary",
    "result",
    "candidate_hash",
    "findings",
    "qualification_receipts"
  ],
  "title": "Immutable consolidated tester result",
  "type": "object"
}
