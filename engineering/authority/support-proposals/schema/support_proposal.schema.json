{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aionbound://engineering/authority/support-proposal-v1",
  "title": "Wave 1 Creative Support Proposal",
  "type": "object",
  "required": [
    "ticket_id",
    "status",
    "schema_version",
    "authority_effect",
    "source_authorities",
    "proposal",
    "approval_required"
  ],
  "properties": {
    "ticket_id": {"pattern": "^W1-CREATIVE-[0-9]{3}$"},
    "status": {"const": "PROPOSED_NOT_RATIFIED"},
    "schema_version": {"const": 1},
    "authority_effect": {"const": "NONE_UNTIL_RATIFIED"},
    "source_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "proposal": {"type": "object"},
    "approval_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision_id", "question"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
