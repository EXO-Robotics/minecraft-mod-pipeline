{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionforge.local/schemas/engineering-evidence-receipt.v1.json",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "id": { "minLength": 1, "type": "string" },
        "mcaddon_sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "tree": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
      },
      "required": ["id", "commit", "tree", "mcaddon_sha256"],
      "type": "object"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assertions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "actual": {},
                "expected": {},
                "matched": { "type": "boolean" },
                "name": { "minLength": 1, "type": "string" }
              },
              "required": ["name", "expected", "actual", "matched"],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "command": { "items": { "type": "string" }, "minItems": 1, "type": "array" },
          "evidence_files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": { "minLength": 1, "type": "string" },
                "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
                "size": { "minimum": 0, "type": "integer" }
              },
              "required": ["path", "sha256", "size"],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "exit_code": { "type": "integer" },
          "id": { "minLength": 1, "type": "string" },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL"] }
        },
        "required": ["id", "required", "command", "exit_code", "assertions", "evidence_files", "status"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": { "const": "aionbound.engineering-evidence-receipt.v1" },
    "status": { "enum": ["PASS", "FAIL"] },
    "status_basis": { "const": "derived from required check exit codes and assertion equality; evidence files are hash-bound" }
  },
  "required": ["schema", "candidate", "checks", "status", "status_basis"],
  "type": "object"
}
