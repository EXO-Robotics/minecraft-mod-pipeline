{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_coverage", "contracted_coverage", "implemented_coverage", "static_qualified_coverage", "server_qualified_coverage", "client_qualified_coverage", "physical_qualified_coverage"],
      "properties": {
        "planned_coverage": {"$ref": "#/$defs/metric"},
        "contracted_coverage": {"$ref": "#/$defs/metric"},
        "implemented_coverage": {"$ref": "#/$defs/metric"},
        "static_qualified_coverage": {"$ref": "#/$defs/metric"},
        "server_qualified_coverage": {"$ref": "#/$defs/metric"},
        "client_qualified_coverage": {"$ref": "#/$defs/metric"},
        "physical_qualified_coverage": {"$ref": "#/$defs/metric"}
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered_weight", "total_weight", "basis_points", "status", "mandatory_pending"],
      "properties": {
        "covered_weight": {"type": "integer", "minimum": 0},
        "total_weight": {"type": "integer", "minimum": 1},
        "basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "status": {"enum": ["SATISFIED", "BLOCKED_MANDATORY_NODES"]},
        "mandatory_pending": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
