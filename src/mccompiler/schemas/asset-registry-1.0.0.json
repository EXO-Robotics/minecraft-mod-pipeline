{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-registry-1.0.0",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "status", "rights_status", "root", "semantic_source_hash", "content_hashes", "physical_ps4", "marketplace"]
      }
    }
  }
}
