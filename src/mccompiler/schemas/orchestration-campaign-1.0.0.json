{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mccompiler/orchestration-campaign-1.0.0.json",
  "title": "Minecraft reconstruction orchestration campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "name",
    "kind",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "JAVA_TO_BEDROCK"
    },
    "metadata": {
      "type": "object"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/job"
      }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "stage",
        "lane",
        "kind",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string"
        },
        "lane": {
          "enum": [
            "EVIDENCE",
            "CONTROL",
            "PRODUCTION",
            "INTEGRATION",
            "AUDIT",
            "QUALIFICATION"
          ]
        },
        "kind": {
          "enum": [
            "command",
            "transfer",
            "manual_gate"
          ]
        },
        "payload": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "type": "integer"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
