{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blockbench-asset-manifest-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "runtime_identifier",
    "namespace",
    "asset_class",
    "rights_status",
    "gameplay_role",
    "geometry_budget",
    "texture_budget",
    "bone_contract",
    "locator_contract",
    "animation_contract",
    "collision_contract",
    "visible_bounds_contract",
    "validation_requirements"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_.-]+$"},
    "runtime_identifier": {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_.-]+$"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "asset_class": {"enum": ["block", "attachable", "item", "prop", "entity", "animal", "boss", "tree"]},
    "rights_status": {"enum": ["original_generated", "licensed_reuse", "public_domain", "reference_constrained", "similarity_review_failed", "rights_blocked"]},
    "gameplay_role": {"type": "string", "minLength": 1},
    "geometry_budget": {"type": "object"},
    "texture_budget": {"type": "object"},
    "bone_contract": {"type": "object"},
    "locator_contract": {"type": "object"},
    "animation_contract": {"type": "object"},
    "collision_contract": {"type": "object"},
    "visible_bounds_contract": {"type": "object"},
    "validation_requirements": {"type": "array", "items": {"type": "string"}}
  }
}
