{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/distillation-output-1.0.0.json",
  "title": "Distillation quarter scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "effort_budget_basis_points", "selection", "systems", "review_adjustments_applied"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "target": {"const": "MARKETPLACE_ADDON_STABLE"},
    "effort_budget_basis_points": {"type": "integer", "minimum": 1, "maximum": 10000},
    "selection": {
      "type": "object",
      "required": ["ids", "effort_units", "effort_limit_units", "console_cost_units", "progression_complete", "missing_progression_stages"],
      "properties": {
        "ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "effort_units": {"type": "integer", "minimum": 0},
        "effort_limit_units": {"type": "integer", "minimum": 0},
        "console_cost_units": {"type": "integer", "minimum": 0},
        "progression_complete": {"type": "boolean"},
        "missing_progression_stages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "systems": {"type": "array", "items": {"type": "object"}},
    "review_adjustments_applied": {"type": "boolean"}
  }
}
