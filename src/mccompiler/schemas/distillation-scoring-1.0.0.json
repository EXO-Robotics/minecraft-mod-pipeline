{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/distillation-scoring-1.0.0.json",
  "title": "Deterministic distillation scoring report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "weights_version", "scores", "feature_scores"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "weights_version": {"type": "string"},
    "feature_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_id", "system_id", "raw_score_milli", "confidence_basis_points", "basis", "evidence_gaps"],
        "properties": {
          "feature_id": {"type": "string"},
          "system_id": {"type": "string"},
          "raw_score_milli": {"type": "integer"},
          "confidence_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
          "basis": {"type": "string"}
          ,"evidence_gaps": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system_id", "raw_score_milli", "confidence_basis_points", "dimensions", "weighted_contributions", "evidence_gaps"],
        "properties": {
          "system_id": {"type": "string"},
          "raw_score_milli": {"type": "integer"},
          "confidence_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
          "dimensions": {"type": "object"},
          "weighted_contributions": {"type": "object"},
          "evidence_gaps": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
