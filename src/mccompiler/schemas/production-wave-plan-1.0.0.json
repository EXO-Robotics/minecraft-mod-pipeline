{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "weights_label", "authoritative_scope", "waves", "deferred", "hard_caps", "required_reserves", "physical_ps4_verified"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "target": {"const": "PS4_PLANNING_PROXY"},
    "weights_label": {"const": "UNCALIBRATED_PS4_PLANNING_PROXY_INPUTS"},
    "authoritative_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "hard_ceiling", "planning_ceiling", "reserve", "protected_minimum", "reserve_consumed"],
      "properties": {
        "current": {"const": 62},
        "hard_ceiling": {"const": 80},
        "planning_ceiling": {"const": 64},
        "reserve": {"const": 18},
        "protected_minimum": {"const": 16},
        "reserve_consumed": {"const": false}
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave", "elements", "usage", "reserve_preserved"],
        "properties": {
          "wave": {"type": "integer", "minimum": 1},
          "elements": {"type": "array", "items": {"type": "string"}},
          "usage": {"$ref": "#/$defs/dimensions"},
          "reserve_preserved": {"$ref": "#/$defs/dimensions"}
        }
      }
    },
    "deferred": {"type": "array", "items": {"type": "string"}},
    "hard_caps": {"$ref": "#/$defs/dimensions"},
    "required_reserves": {"$ref": "#/$defs/dimensions"},
    "physical_ps4_verified": {"const": false}
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_tick_workload", "active_entities", "pathfinding_pressure", "projectiles", "particles", "texture_memory", "geometry_complexity", "animation_controller_complexity", "persistence_growth", "multiplayer_multiplier", "cleanup_latency", "worst_credible_scene"],
      "properties": {
        "script_tick_workload": {"type": "integer", "minimum": 0},
        "active_entities": {"type": "integer", "minimum": 0},
        "pathfinding_pressure": {"type": "integer", "minimum": 0},
        "projectiles": {"type": "integer", "minimum": 0},
        "particles": {"type": "integer", "minimum": 0},
        "texture_memory": {"type": "integer", "minimum": 0},
        "geometry_complexity": {"type": "integer", "minimum": 0},
        "animation_controller_complexity": {"type": "integer", "minimum": 0},
        "persistence_growth": {"type": "integer", "minimum": 0},
        "multiplayer_multiplier": {"type": "integer", "minimum": 0},
        "cleanup_latency": {"type": "integer", "minimum": 0},
        "worst_credible_scene": {"type": "integer", "minimum": 0}
      }
    }
  }
}
