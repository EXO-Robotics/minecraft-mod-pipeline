{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "originality-record-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "contract_id", "creator_mode", "design_seed", "design_profile_revision", "source_restrictions", "independently_created_elements", "mechanics_retained_at_abstract_level", "expressive_elements_replaced", "name_provenance", "visual_provenance", "structure_provenance", "reward_provenance", "progression_provenance", "known_similarities", "revision_history", "screening_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "creator_mode": {"enum": ["clean_room_originalization", "authorized_adaptation"]},
    "design_seed": {"type": ["string", "integer"]},
    "design_profile_revision": {"type": "string", "minLength": 1},
    "source_restrictions": {"type": "array", "items": {"type": "string"}},
    "independently_created_elements": {"type": "array", "items": {"type": "string"}},
    "mechanics_retained_at_abstract_level": {"type": "array", "items": {"type": "string"}},
    "expressive_elements_replaced": {"type": "array", "items": {"type": "string"}},
    "name_provenance": {},
    "visual_provenance": {},
    "structure_provenance": {},
    "reward_provenance": {},
    "progression_provenance": {},
    "known_similarities": {"type": "array"},
    "revision_history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "screening_status": {"enum": ["AUTOMATED_SCREEN_LOW_RISK", "HUMAN_REVIEW_REQUIRED", "REVISION_REQUIRED", "OMIT_PENDING_LICENSE", "SCREENING_INSUFFICIENT"]}
  }
}
