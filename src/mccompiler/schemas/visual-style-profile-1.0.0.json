{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-style-profile-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "theme",
    "shape_language",
    "blockiness",
    "silhouette_priorities",
    "palette_families",
    "material_families",
    "contrast",
    "texture_density",
    "texture_resolution_limits",
    "noise_limits",
    "anatomy_conventions",
    "weapon_proportions",
    "boss_escalation",
    "animation_timing",
    "readability",
    "originality_constraints",
    "prohibited_traits",
    "performance_budgets"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "namespace": {"type": "string"},
    "theme": {"type": "string"},
    "shape_language": {"type": "array", "items": {"type": "string"}},
    "blockiness": {"type": "string"},
    "silhouette_priorities": {"type": "array", "items": {"type": "string"}},
    "palette_families": {"type": "array", "items": {"type": "string"}},
    "material_families": {"type": "array", "items": {"type": "string"}},
    "contrast": {"type": "object"},
    "texture_density": {"type": "string"},
    "texture_resolution_limits": {"type": "object"},
    "noise_limits": {"type": "object"},
    "anatomy_conventions": {"type": "array", "items": {"type": "string"}},
    "weapon_proportions": {"type": "array", "items": {"type": "string"}},
    "boss_escalation": {"type": "array", "items": {"type": "string"}},
    "animation_timing": {"type": "object"},
    "readability": {"type": "array", "items": {"type": "string"}},
    "originality_constraints": {"type": "array", "items": {"type": "string"}},
    "prohibited_traits": {"type": "array", "items": {"type": "string"}},
    "performance_budgets": {"type": "object"}
  }
}
