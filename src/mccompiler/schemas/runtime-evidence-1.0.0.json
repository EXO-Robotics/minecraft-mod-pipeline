{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/runtime-evidence-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_hash", "build_hash", "runtime_id", "world_id", "test_id", "started_at", "ended_at", "log_hash", "checks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "test_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "log_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "classification", "status"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "classification": {"enum": ["handler", "adapter_integration", "gameplay", "persistence", "multiplayer", "console"]},
          "status": {"enum": ["PASSED", "FAILED", "NOT_RUN", "BLOCKED"]},
          "details": {"type": "object"}
        }
      }
    }
  }
}
