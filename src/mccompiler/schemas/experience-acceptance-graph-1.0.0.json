{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "nodes": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "weight",
          "mandatory",
          "acceptance_requirements",
          "implementation_refs",
          "contract_refs",
          "evidence_refs",
          "qualification_requirements",
          "current_status",
          "confidence",
          "blocking_findings"
        ],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "weight": {"type": "integer", "minimum": 1},
          "mandatory": {"type": "boolean"},
          "acceptance_requirements": {"type": "array", "items": {"type": "string"}},
          "implementation_refs": {"type": "array", "items": {"type": "string"}},
          "contract_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "qualification_requirements": {"type": "array", "items": {"type": "string"}},
          "current_status": {
            "enum": [
              "planned",
              "contracted",
              "implemented",
              "static_qualified",
              "server_qualified",
              "client_qualified",
              "physical_qualified"
            ]
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "blocking_findings": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
