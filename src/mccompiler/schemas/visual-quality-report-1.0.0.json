{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-quality-report-1.0.0",
  "type": "object",
  "required": ["schema_version", "asset_id", "profile_revision", "views", "scores", "blocking_findings", "disposition"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "asset_id": {"type": "string"},
    "profile_revision": {"type": "string"},
    "views": {"type": "array", "items": {"type": "object"}},
    "scores": {"type": "object"},
    "blocking_findings": {"type": "array"},
    "disposition": {"enum": ["PASSED", "FAILED"]}
  }
}
