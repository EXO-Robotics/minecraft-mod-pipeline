{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/rights-manifest-1.0.0.json",
  "title": "Rights Manifest 1.0.0",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["content_id", "content_type", "source", "rights", "evidence", "decision"],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "content_type": {"enum": ["source_code", "texture", "model", "animation", "sound", "music", "structure", "character", "name", "logo", "branding", "trademark", "documentation", "dependency"]},
        "source": {"type": "object"},
        "rights": {"type": "object"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "decision": {"$ref": "rights-review-1.0.0.json#/$defs/decision"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
