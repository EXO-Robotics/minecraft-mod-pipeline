{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/platform-evidence-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platforms", "console_verified", "marketplace_approval_implied"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows_local", "realm_windows", "playstation", "xbox"],
      "properties": {
        "windows_local": {"$ref": "#/$defs/status"},
        "realm_windows": {"$ref": "#/$defs/status"},
        "playstation": {"$ref": "#/$defs/status"},
        "xbox": {"$ref": "#/$defs/status"}
      }
    },
    "console_verified": {"type": "boolean"},
    "marketplace_approval_implied": {"const": false},
    "valid": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ids"],
      "properties": {
        "status": {"enum": ["UNVERIFIED", "NOT_RUN", "PASSED", "FAILED", "BLOCKED"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
