{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/distillation-input-1.0.0.json",
  "title": "Distillation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "console_limit_units", "systems"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "identity": {
      "type": "object",
      "required": ["summary", "load_bearing_systems"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "load_bearing_systems": {"type": "array", "items": {"type": "string"}}
      }
    },
    "console_limit_units": {"type": "integer", "minimum": 1},
    "analysis_status": {"enum": ["EVIDENCE_BACKED", "PRELIMINARY_EVIDENCE_GAPS"]},
    "default_originality_evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "default_stable_api_status": {"enum": ["COMPATIBLE", "UNKNOWN", "UNSUPPORTED"]},
    "scan_provenance": {"type": "object"},
    "required_progression_stages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "default_dimensions": {"type": "object"},
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/system"}
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["KNOWN", "UNKNOWN"]},
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "system": {
      "type": "object",
      "required": [
        "id", "name", "effort_units", "console_cost_units", "stable_api_status", "dimensions",
        "encounter", "reward", "unlock", "future_support",
        "removable_without_breaking_progression", "unlocks"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "effort_units": {"type": "integer", "minimum": 0},
        "console_cost_units": {"type": "integer", "minimum": 0},
        "strategy": {"enum": ["DIRECT_RECONSTRUCTION", "BEDROCK_NATIVE_REDESIGN", "ORIGINAL_REPLACEMENT", "DEFER", "UNSUPPORTED", "RIGHTS_BLOCKED"]},
        "stable_api_status": {"enum": ["COMPATIBLE", "UNKNOWN", "UNSUPPORTED"]},
        "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unlocks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "progression_stages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "feature_ids": {"type": "array", "items": {"type": "string"}},
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "dimensions"],
            "properties": {
              "id": {"type": "string"},
              "dimensions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/dimension"}}
            }
          }
        },
        "patterns": {"type": "array", "items": {"type": "string"}},
        "dimensions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/dimension"}},
        "encounter": {"type": "string"},
        "reward": {"type": "string"},
        "unlock": {"type": "string"},
        "future_support": {"type": "string"},
        "removable_without_breaking_progression": {"type": "boolean"}
      }
    }
  }
}
