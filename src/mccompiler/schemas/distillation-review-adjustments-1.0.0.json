{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/distillation-review-adjustments-1.0.0.json",
  "title": "Separate advisory review adjustments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adjustments"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "author", "author_type", "reason", "evidence", "change"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "author": {"type": "string", "minLength": 1},
          "author_type": {"enum": ["HUMAN", "AI"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "change": {"type": "object"}
          ,"authority": {"const": "ADVISORY_ONLY"}
        }
      }
    }
  }
}
