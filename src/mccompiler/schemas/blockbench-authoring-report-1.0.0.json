{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blockbench-authoring-report-1.0.0",
  "type": "object",
  "required": ["schema_version", "operation", "status", "asset_id", "deterministic_seed", "blockbench_version", "exporter_version", "native_roundtrip", "semantic_source_hash", "content_hashes", "repair_history", "claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "operation": {"const": "author_blockbench_asset"},
    "status": {"enum": ["QUALIFIED", "AUTONOMOUS_AUTHORING_FAILED"]},
    "asset_id": {"type": "string"},
    "deterministic_seed": {"type": "integer", "minimum": 0},
    "blockbench_version": {"type": "string"},
    "exporter_version": {"type": "string"},
    "native_roundtrip": {"type": "object"},
    "semantic_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_hashes": {"type": "object"},
    "repair_history": {"type": "array"},
    "claims": {"type": "object"}
  }
}
