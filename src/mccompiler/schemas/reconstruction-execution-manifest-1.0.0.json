{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccompiler.local/schemas/reconstruction-execution-manifest-1.0.0.json",
  "title": "Diagnostic-only reconstruction execution manifest",
  "type": "object",
  "required": [
    "schema_version",
    "report_type",
    "wave_id",
    "diagnostic_only",
    "execution_not_authorized",
    "execution_authorized",
    "authorization_is_immutable_in_diagnostic_operation",
    "authorized_features",
    "blocked_or_deferred_features",
    "transformation_dispositions",
    "original_assets_to_generate",
    "behavior_and_script_systems",
    "structures_to_create",
    "files_to_create",
    "files_to_modify",
    "protected_custom_regions",
    "planned_blockbench_operations",
    "planned_cost",
    "planned_tests",
    "known_limitations",
    "rights_restrictions",
    "rollback_point",
    "expected_package_outputs",
    "maximum_autonomous_repair_iterations",
    "stop_conditions",
    "failure_conditions",
    "physical_checks_remaining",
    "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_type": {"const": "execution_manifest"},
    "wave_id": {"const": "forest-wave-1"},
    "diagnostic_only": {"const": true},
    "execution_not_authorized": {"const": true},
    "execution_authorized": {"const": false},
    "authorization_is_immutable_in_diagnostic_operation": {"const": true},
    "authorized_features": {"type": "array", "maxItems": 0},
    "blocked_or_deferred_features": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "transformation_dispositions": {"type": "object"},
    "original_assets_to_generate": {"type": "object"},
    "behavior_and_script_systems": {"type": "object"},
    "structures_to_create": {"type": "array", "items": {"type": "string"}},
    "files_to_create": {"type": "array", "items": {"type": "string"}},
    "files_to_modify": {"type": "array", "items": {"type": "string"}},
    "protected_custom_regions": {"type": "array", "items": {"type": "string"}},
    "planned_blockbench_operations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "planned_cost": {"type": "object"},
    "planned_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rights_restrictions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_point": {
      "type": "object",
      "required": ["git_commit", "forest_plan_component_hash", "forest_package_sha256"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "forest_plan_component_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "forest_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "expected_package_outputs": {"type": "array", "items": {"type": "string"}},
    "maximum_autonomous_repair_iterations": {"type": "integer", "minimum": 0, "maximum": 3},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "physical_checks_remaining": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
