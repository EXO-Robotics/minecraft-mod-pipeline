{
  "schema_version": "1.0.0",
  "classification": "adapter_integration",
  "gameplay_or_console_evidence": false,
  "probes": [
    {
      "check_id": "doorlock-fixture-ticking-area",
      "cycle": 1,
      "after_boot_seconds": 1,
      "command": "tickingarea add circle 10 64 10 1 mccompiler_probe true",
      "expect_output": "Added ticking area"
    },
    {
      "check_id": "doorlock-fixture-trapdoor",
      "cycle": 1,
      "after_boot_seconds": 3,
      "command": "setblock 10 64 10 trapdoor [\"open_bit\"=false]",
      "expect_output": "Block placed"
    },
    {
      "check_id": "doorlock-redstone-force-open",
      "cycle": 2,
      "after_boot_seconds": 3,
      "command": "setblock 10 64 10 trapdoor [\"open_bit\"=true]",
      "expect_output": "Block placed"
    },
    {
      "check_id": "doorlock-redstone-restored",
      "cycle": 2,
      "after_boot_seconds": 6,
      "command": "testforblock 10 64 10 trapdoor [\"open_bit\"=false]",
      "expect_output": "Successfully found the block at 10,64,10."
    },
    {
      "check_id": "doorlock-redstone-restart-state",
      "cycle": 3,
      "after_boot_seconds": 3,
      "command": "testforblock 10 64 10 trapdoor [\"open_bit\"=false]",
      "expect_output": "Successfully found the block at 10,64,10."
    }
  ]
}
