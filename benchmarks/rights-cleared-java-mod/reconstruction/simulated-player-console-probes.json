{
  "schema_version": "1.0.0",
  "classification": "simulated_player_fixture",
  "gameplay_or_console_evidence": false,
  "probes": [
    {
      "check_id": "doorlock-simulated-fixture-ticking-area",
      "cycle": 1,
      "after_boot_seconds": 1,
      "command": "tickingarea add circle 10 64 10 1 mccompiler_simulated true",
      "expect_output": "Added ticking area"
    },
    {
      "check_id": "doorlock-simulated-fixture-chest",
      "cycle": 1,
      "after_boot_seconds": 3,
      "command": "setblock 10 64 10 chest",
      "expect_output": "Block placed"
    },
    {
      "check_id": "doorlock-simulated-upgrade-ticking-area",
      "cycle": 2,
      "after_boot_seconds": 1,
      "command": "tickingarea add circle 10 64 10 1 mccompiler_upgrade true",
      "expect_output": "Added ticking area"
    },
    {
      "check_id": "doorlock-simulated-arm-after-upgrade",
      "cycle": 2,
      "after_boot_seconds": 3,
      "command": "setblock 11 64 10 gold_block",
      "expect_output": "Block placed"
    },
    {
      "check_id": "doorlock-simulated-locked-chest-broken",
      "cycle": 2,
      "after_boot_seconds": 12,
      "command": "testforblock 10 64 10 air",
      "expect_output": "Successfully found the block at 10,64,10."
    }
  ]
}
