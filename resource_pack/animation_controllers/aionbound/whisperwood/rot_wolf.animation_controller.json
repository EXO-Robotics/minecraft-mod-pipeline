{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.aionbound.rot_wolf.runtime": {
      "initial_state": "idle",
      "states": {
        "idle": { "animations": ["idle"], "transitions": [{ "death": "!query.is_alive" }, { "hurt": "query.hurt_time > 0.0" }, { "attack": "(query.has_target && !query.is_moving)" }, { "run": "query.modified_move_speed > 0.28" }, { "move": "query.is_moving" }] },
        "move": { "animations": ["move"], "transitions": [{ "death": "!query.is_alive" }, { "hurt": "query.hurt_time > 0.0" }, { "attack": "(query.has_target && !query.is_moving)" }, { "run": "query.modified_move_speed > 0.28" }, { "idle": "!query.is_moving" }] },
        "run": { "animations": ["run"], "transitions": [{ "death": "!query.is_alive" }, { "hurt": "query.hurt_time > 0.0" }, { "attack": "(query.has_target && !query.is_moving)" }, { "move": "query.modified_move_speed <= 0.28 && query.is_moving" }, { "idle": "!query.is_moving" }] },
        "attack": { "animations": ["attack"], "transitions": [{ "death": "!query.is_alive" }, { "hurt": "query.hurt_time > 0.0" }, { "move": "query.any_animation_finished && query.is_moving" }, { "idle": "query.any_animation_finished && !query.is_moving" }] },
        "hurt": { "animations": ["hurt"], "transitions": [{ "death": "!query.is_alive" }, { "move": "query.hurt_time <= 0.0 && query.is_moving" }, { "idle": "query.hurt_time <= 0.0 && !query.is_moving" }] },
        "death": { "animations": ["death"] }
      }
    }
  }
}
