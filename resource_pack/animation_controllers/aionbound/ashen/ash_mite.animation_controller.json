{
  "animation_controllers": {
    "controller.animation.aionbound.ashen.ash_mite.runtime": {
      "initial_state": "idle",
      "states": {
        "action": {
          "animations": [
            "skitter"
          ],
          "transitions": [
            {
              "death": "!query.is_alive"
            },
            {
              "hurt": "query.hurt_time > 0.0"
            },
            {
              "move": "query.any_animation_finished && query.is_moving"
            },
            {
              "idle": "query.any_animation_finished && !query.is_moving"
            }
          ]
        },
        "death": {
          "animations": [
            "death"
          ]
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "transitions": [
            {
              "death": "!query.is_alive"
            },
            {
              "move": "query.hurt_time <= 0.0 && query.is_moving"
            },
            {
              "idle": "query.hurt_time <= 0.0 && !query.is_moving"
            }
          ]
        },
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "death": "!query.is_alive"
            },
            {
              "hurt": "query.hurt_time > 0.0"
            },
            {
              "action": "query.has_target && !query.is_moving"
            },
            {
              "move": "query.is_moving"
            }
          ]
        },
        "move": {
          "animations": [
            "skitter"
          ],
          "transitions": [
            {
              "death": "!query.is_alive"
            },
            {
              "hurt": "query.hurt_time > 0.0"
            },
            {
              "action": "query.has_target && !query.is_moving"
            },
            {
              "idle": "!query.is_moving"
            }
          ]
        }
      }
    }
  },
  "format_version": "1.10.0"
}
