{
  "schemaVersion": 1,
  "id": "authentic_fabric",
  "version": "1.0.0",
  "name": "Authentic Fabric Fixture",
  "environment": "*",
  "entrypoints": {
    "main": ["fixture.fabric.AuthenticFabricMod"],
    "client": [{"adapter": "default", "value": "fixture.fabric.AuthenticFabricClient"}]
  },
  "mixins": ["authentic_fabric.mixins.json"],
  "accessWidener": "authentic_fabric.accesswidener",
  "jars": [{"file": "META-INF/jars/helper.jar"}],
  "provides": ["fabric-fixture-alias"],
  "license": "CC0-1.0",
  "depends": {"fabricloader": ">=0.16.0", "minecraft": "~1.21"},
  "custom": {"fixture_marker": "must-survive-losslessly"}
}
